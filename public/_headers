/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin

# HTML should never be cached long — it's the entry point for every deploy
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# Short cache for JS/CSS so new deploys appear immediately on refresh.
# Content-hashed assets can override this per-file.
/js/*
  Cache-Control: public, max-age=60, must-revalidate
/css/*
  Cache-Control: public, max-age=60, must-revalidate

# Static-ish: fonts, images
/assets/*
  Cache-Control: public, max-age=86400
